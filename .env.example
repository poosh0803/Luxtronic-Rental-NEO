PORT=8003

# Luxtronic Portal notifications (overdue-rental alerts) - both have working
# defaults baked into src/lateNotifier.js for the current LAN deployment, so
# these only need setting if the portal or this app's public URL changes.
# PORTAL_NOTIFICATIONS_URL=http://192.168.68.255/api/notifications
# PUBLIC_BASE_URL=http://192.168.68.255:8003

# Luxtronic Odoo API (mirrors rental create/edit/return/delete to Odoo Online) -
# defaults to localhost:4001 in src/odooSync.js, which is correct while both
# services run on the same server; only set this if the Odoo API moves.
# ODOO_API_URL=http://localhost:4001
